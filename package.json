{
  "name": "down-the-stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Follow one real web request from the keystroke to the radio wave. Every byte is real.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "capture": "node scripts/capture.mjs && node scripts/extract.mjs"
  },
  "dependencies": {
    "solid-js": "^1.9.3",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.2",
    "@types/three": "^0.170.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.11.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.11"
  }
}
